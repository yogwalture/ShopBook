{
  "entities": {
    "Firm": {
      "title": "Firm",
      "description": "Details of registered pharmacy business unit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique firm ID" },
        "name": { "type": "string", "description": "Business unit name" },
        "adminName": { "type": "string", "description": "Name of the key administrator" },
        "email": { "type": "string", "description": "Business contact email" },
        "mobile": { "type": "string", "description": "Mobile contact number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "password": { "type": "string", "description": "Access password for the firm admin" },
        "users": {
          "type": "array",
          "description": "Registered counter staff users"
        }
      },
      "required": ["id", "name", "adminName", "email", "mobile", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger transactions including sales, receipts and operational expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmId": { "type": "string" },
        "type": { "type": "string", "enum": ["credit_sale", "receive_payment", "supplier_payment", "scheme_bill", "staff_credit", "staff_advance"] },
        "title": { "type": "string" },
        "patientName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "salesmanName": { "type": "string" },
        "recordedByUserId": { "type": "string" },
        "recordedByUserName": { "type": "string" },
        "extraDetails": { "type": "string" }
      },
      "required": ["id", "firmId", "type", "title", "amount", "date", "time", "recordedByUserId", "recordedByUserName"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Database of regular customers and their outstanding ledger balances",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["Overdue", "Pending", "Paid"] },
        "pendingBalance": { "type": "number" },
        "lastPaymentDate": { "type": "string" }
      },
      "required": ["id", "firmId", "name", "phone", "status", "pendingBalance", "lastPaymentDate"]
    },
    "FirmDailyRegister": {
      "title": "FirmDailyRegister",
      "description": "Register of daily cash flow, counters, opening, and closing statuses",
      "type": "object",
      "properties": {
        "opening": { "type": "number" },
        "cashSales": { "type": "number" },
        "onlineSales": { "type": "number" },
        "closed": { "type": "boolean" },
        "forwarded": { "type": "number" }
      },
      "required": ["opening", "cashSales", "onlineSales", "closed"]
    },
    "Handover": {
      "title": "Handover",
      "description": "Daily shift handover between operators with balance declarations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmId": { "type": "string" },
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "toUserId": { "type": "string" },
        "toUserName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "handoverTime": { "type": "string" },
        "handoverDate": { "type": "string" },
        "closingCashBalance": { "type": "number" },
        "closingUpiBalance": { "type": "number" },
        "totalTransactionsCount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "firmId", "fromUserId", "fromUserName", "toUserId", "toUserName", "status", "handoverTime", "handoverDate", "closingCashBalance", "closingUpiBalance", "totalTransactionsCount"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Highly durable automated system data snapshots",
      "type": "object",
      "properties": {
        "firmId": { "type": "string" },
        "isAuto": { "type": "boolean" },
        "autoBackupTime": { "type": "string" },
        "transactions": { "type": "array" },
        "customers": { "type": "array" },
        "firmDailyRegisters": { "type": "object" }
      },
      "required": ["firmId", "isAuto", "autoBackupTime"]
    },
    "StaffAttendance": {
      "title": "StaffAttendance",
      "description": "Daily staff shift check-in and check-out attendance records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmId": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "staffMobile": { "type": "string" },
        "role": { "type": "string" },
        "date": { "type": "string" },
        "shiftType": { "type": "string", "enum": ["Morning", "Evening", "Night", "Full Day"] },
        "status": { "type": "string", "enum": ["Present", "Half Day", "Absent", "On Leave"] },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "totalHours": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "notes": { "type": "string" },
        "recordedByUserId": { "type": "string" },
        "recordedByUserName": { "type": "string" }
      },
      "required": ["id", "firmId", "staffId", "staffName", "date", "shiftType", "status", "checkInTime"]
    }
  },
  "firestore": {
    "/firms/{firmId}": {
      "schema": "Firm",
      "description": "Firms directory"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Consolidated financial ledger items"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Outstanding customer register profiles"
    },
    "/firmDailyRegisters/{registerId}": {
      "schema": "FirmDailyRegister",
      "description": "Register tracking daily lock/open state balances"
    },
    "/handovers/{handoverId}": {
      "schema": "Handover",
      "description": "Daily operator shift handovers and status validations"
    },
    "/backups/{backupId}": {
      "schema": "Backup",
      "description": "System database full-sync recovery and automated backups"
    },
    "/staffAttendance/{attendanceId}": {
      "schema": "StaffAttendance",
      "description": "Staff attendance shift logs and duty check-ins"
    }
  }
}
